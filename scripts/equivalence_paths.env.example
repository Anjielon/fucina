# Settings for scripts/run_equivalence_after_passata.sh. Copy to scripts/equivalence_paths.env (not versioned).
PYTHON=/path/to/venv-with-rocm-torch-and-triton/bin/python3
# optional: site-packages of another Python of the same version that has pytest (pure-Python packages only)
FUCINA_PYTEST_SITE=
# original trees (read only)
FUCINA_ORIG_THOR_V2=/path/to/original/thor_v2
FUCINA_ORIG_S23=/path/to/original/s23_code_root          # contains s23/ lib/ s1b/ rif/
FUCINA_ORIG_KERNEL_ROT=/path/to/kernel-rotazione
# gguf-py of the llama.cpp build with the TQ1_0R_1024 type
FUCINA_GGUF_PY=/path/to/llama.cpp/gguf-py
# wait until this marker exists and this user unit is inactive
WAIT_MARKER=/path/to/run/DONE_MARKER
WAIT_UNIT=
